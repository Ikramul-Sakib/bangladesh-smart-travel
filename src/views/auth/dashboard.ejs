<%- include('../partials/head') %>
    <%- include('../partials/navbar') %>
        <%- include('../partials/flash') %>

            <div class="container py-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="fw-bold mb-1">Welcome, <%= currentUser.full_name %>
                        </h2>
                        <p class="text-muted small mb-0">
                            Role: <span class="badge bg-success text-uppercase">
                                <%= currentUser.role %>
                            </span> |
                            Email: <%= currentUser.email %>
                        </p>
                    </div>
                    <div class="d-flex gap-2 mt-2 mt-md-0">
                        <a href="/trips/plan" class="btn btn-bd-emerald btn-sm">
                            <i class="bi bi-plus-circle me-1"></i>Create New Travel Plan
                        </a>
                        <a href="/agents" class="btn btn-outline-success btn-sm">
                            <i class="bi bi-people me-1"></i>Browse Tour Agents
                        </a>
                    </div>
                </div>

                <div class="row g-4">
                    <!-- Profile Management Card -->
                    <div class="col-lg-4">
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-body p-4">
                                <h5 class="fw-bold mb-3"><i class="bi bi-person-gear me-2 text-bd-emerald"></i>My
                                    Profile</h5>
                                <form action="/dashboard/profile" method="POST">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold">Full Name</label>
                                        <input type="text" name="full_name" class="form-control"
                                            value="<%= currentUser.full_name %>" required />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold">Email (Read-only)</label>
                                        <input type="email" class="form-control bg-light"
                                            value="<%= currentUser.email %>" disabled />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold">Phone Number</label>
                                        <input type="text" name="phone" class="form-control"
                                            value="<%= currentUser.phone %>" required />
                                    </div>
                                    <button type="submit" class="btn btn-bd-emerald btn-sm w-100">Update
                                        Profile</button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Saved Travel Plans & Bookings -->
                    <div class="col-lg-8">
                        <!-- Saved Travel Plans -->
                        <div class="card border-0 shadow-sm rounded-4 mb-4">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="fw-bold mb-0"><i class="bi bi-map me-2 text-bd-emerald"></i>Saved Travel
                                        Plans</h5>
                                    <a href="/trips/plan"
                                        class="btn btn-sm btn-link text-bd-emerald text-decoration-none">+ New Plan</a>
                                </div>

                                <% if (savedPlans && savedPlans.length> 0) { %>
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle small">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Destination</th>
                                                    <th>Dates</th>
                                                    <th>Travelers</th>
                                                    <th>Budget (৳)</th>
                                                    <th>Est. Cost (৳)</th>
                                                    <th>Status</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% savedPlans.forEach(plan=> { %>
                                                    <tr>
                                                        <td class="fw-semibold">
                                                            <%= plan.destination_name %>
                                                        </td>
                                                        <td>
                                                            <%= new Date(plan.departure_date).toLocaleDateString() %> -
                                                                <%= new Date(plan.return_date).toLocaleDateString() %>
                                                        </td>
                                                        <td>
                                                            <%= plan.total_travelers %>
                                                        </td>
                                                        <td>৳<%= Number(plan.total_budget_bdt).toLocaleString() %>
                                                        </td>
                                                        <td class="fw-bold">৳<%=
                                                                Number(plan.total_estimated_cost_bdt).toLocaleString()
                                                                %>
                                                        </td>
                                                        <td>
                                                            <% if (plan.fits_budget) { %>
                                                                <span
                                                                    class="badge bg-success-subtle text-success">Within
                                                                    Budget</span>
                                                                <% } else { %>
                                                                    <span
                                                                        class="badge bg-danger-subtle text-danger">Over
                                                                        Budget</span>
                                                                    <% } %>
                                                        </td>
                                                        <td>
                                                            <a href="/trips/<%= plan.id %>"
                                                                class="btn btn-outline-secondary btn-sm">View</a>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                    <% } else { %>
                                        <p class="text-muted small mb-0">You haven't saved any travel itineraries yet.
                                        </p>
                                        <% } %>
                            </div>
                        </div>

                        <!-- Tour Agent Booking Requests -->
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-body p-4">
                                <h5 class="fw-bold mb-3"><i class="bi bi-calendar-check me-2 text-bd-emerald"></i>My
                                    Tour Agent Bookings</h5>
                                <% if (bookings && bookings.length> 0) { %>
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle small">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Ref</th>
                                                    <th>Destination</th>
                                                    <th>Agency / Agent</th>
                                                    <th>Dates</th>
                                                    <th>Agent Fee</th>
                                                    <th>Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% bookings.forEach(b=> { %>
                                                    <tr>
                                                        <td><code><%= b.booking_reference %></code></td>
                                                        <td>
                                                            <%= b.destination_name %>
                                                        </td>
                                                        <td>
                                                            <%= b.agency_name %> (<%= b.agent_name %>)
                                                        </td>
                                                        <td>
                                                            <%= new Date(b.departure_date).toLocaleDateString() %> - <%=
                                                                    new Date(b.return_date).toLocaleDateString() %>
                                                        </td>
                                                        <td>৳<%= Number(b.agreed_agent_fee_bdt).toLocaleString() %>
                                                        </td>
                                                        <td>
                                                            <span
                                                                class="badge bg-<%= b.status === 'confirmed' ? 'success' : (b.status === 'rejected' ? 'danger' : 'warning text-dark') %>">
                                                                <%= b.status.toUpperCase() %>
                                                            </span>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                    <% } else { %>
                                        <p class="text-muted small mb-0">No booking requests sent yet.</p>
                                        <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <%- include('../partials/footer') %>