<%- include('../partials/head') %>
    <%- include('../partials/navbar') %>
        <%- include('../partials/flash') %>

            <div class="container-fluid container-xl py-4">
                <div class="row g-4">
                    <div class="col-lg-3">
                        <%- include('../partials/adminSidebar') %>
                    </div>

                    <div class="col-lg-9">
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                            <h3 class="fw-bold mb-0">Transportation Cost Management</h3>
                            <div class="d-flex gap-2">
                                <a href="/admin/csv/export/transport" class="btn btn-outline-success btn-sm">
                                    <i class="bi bi-download me-1"></i>Export CSV
                                </a>
                                <form action="/admin/csv/import/transport?_csrf=<%= csrfToken %>" method="POST"
                                    enctype="multipart/form-data" class="d-flex gap-1">
                                    <input type="file" name="csv_file" accept=".csv"
                                        class="form-control form-control-sm" required />
                                    <button type="submit" class="btn btn-warning btn-sm text-nowrap">Import CSV</button>
                                </form>
                            </div>
                        </div>

                        <!-- Create Transport Fare Form -->
                        <div class="card border-0 shadow-sm rounded-4 mb-4">
                            <div class="card-body p-4">
                                <h5 class="fw-bold text-bd-emerald mb-3">Add Bus, Train, Launch, or Private Car Fare
                                </h5>
                                <form action="/admin/transport" method="POST">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                    <div class="row g-3">
                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold">Transport Type *</label>
                                            <select name="transport_type" class="form-select form-select-sm" required>
                                                <option value="bus">Bus</option>
                                                <option value="train">Train</option>
                                                <option value="private_car">Private Car / Microbus</option>
                                                <option value="launch">Launch / Ship</option>
                                                <option value="flight">Domestic Flight</option>
                                                <option value="other">Other</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold">Departure City *</label>
                                            <input type="text" name="departure_location"
                                                class="form-control form-control-sm" value="Dhaka" required />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold">Destination *</label>
                                            <select name="destination_id" class="form-select form-select-sm" required>
                                                <% destinations.forEach(d=> { %>
                                                    <option value="<%= d.id %>">
                                                        <%= d.name %>
                                                    </option>
                                                    <% }) %>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold">Operator / Service Name
                                                *</label>
                                            <input type="text" name="operator_name" class="form-control form-control-sm"
                                                placeholder="e.g., Green Line / Cox's Bazar Express" required />
                                        </div>

                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold">Comfort Tier</label>
                                            <select name="comfort_tier" class="form-select form-select-sm">
                                                <option value="budget">Budget (Non-AC / Shovan)</option>
                                                <option value="standard" selected>Standard (AC Econ / Snigdha)</option>
                                                <option value="premium">Premium (Sleeper / Business)</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold">Pricing Model</label>
                                            <select name="pricing_model" class="form-select form-select-sm">
                                                <option value="per_person" selected>Per Person Ticket</option>
                                                <option value="per_vehicle">Per Shared Vehicle</option>
                                            </select>
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small fw-semibold">Vehicle Cap.</label>
                                            <input type="number" name="vehicle_capacity"
                                                class="form-control form-control-sm" min="1" value="1" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small fw-semibold">One-Way (৳) *</label>
                                            <input type="number" name="one_way_fare_bdt"
                                                class="form-control form-control-sm" min="1" required />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small fw-semibold">Return (৳)</label>
                                            <input type="number" name="return_fare_bdt"
                                                class="form-control form-control-sm" placeholder="Auto 2x if blank" />
                                        </div>

                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold">Duration (Hours)</label>
                                            <input type="number" step="0.5" name="duration_hours"
                                                class="form-control form-control-sm" value="8.5" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold">Additional Fees (৳)</label>
                                            <input type="number" name="additional_fees_bdt"
                                                class="form-control form-control-sm" value="0" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-semibold">Schedule Info</label>
                                            <input type="text" name="schedule_info" class="form-control form-control-sm"
                                                value="07:00 AM, 10:00 PM Daily" />
                                        </div>

                                        <div class="col-12 d-flex justify-content-between align-items-center">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="is_verified"
                                                    value="1" id="verTrans" />
                                                <label class="form-check-label small" for="verTrans">Mark price as
                                                    Verified (uncheck for Manual Estimate)</label>
                                            </div>
                                            <button type="submit" class="btn btn-bd-emerald btn-sm px-4">Add Transport
                                                Fare</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- Filter & List Table -->
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-body p-4">
                                <form action="/admin/transport" method="GET" class="row g-2 mb-3">
                                    <div class="col-md-4">
                                        <select name="destination_id" class="form-select form-select-sm">
                                            <option value="">All Destinations</option>
                                            <% destinations.forEach(d=> { %>
                                                <option value="<%= d.id %>"
                                                    <%=String(filters.destination_id)===String(d.id) ? 'selected' : ''
                                                    %>><%= d.name %>
                                                </option>
                                                <% }) %>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <select name="transport_type" class="form-select form-select-sm">
                                            <option value="">All Modes</option>
                                            <option value="bus" <%=filters.transport_type==='bus' ? 'selected' : '' %>
                                                >Bus</option>
                                            <option value="train" <%=filters.transport_type==='train' ? 'selected' : ''
                                                %>>Train</option>
                                            <option value="private_car" <%=filters.transport_type==='private_car'
                                                ? 'selected' : '' %>>Private Car</option>
                                            <option value="launch" <%=filters.transport_type==='launch' ? 'selected'
                                                : '' %>>Launch</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <input type="text" name="search" class="form-control form-control-sm"
                                            placeholder="Operator or origin..." value="<%= filters.search %>" />
                                    </div>
                                    <div class="col-md-2">
                                        <button type="submit"
                                            class="btn btn-outline-secondary btn-sm w-100">Filter</button>
                                    </div>
                                </form>

                                <div class="table-responsive">
                                    <table class="table table-hover align-middle small mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Route</th>
                                                <th>Mode / Tier</th>
                                                <th>Operator</th>
                                                <th>One-Way</th>
                                                <th>Return</th>
                                                <th>Status Label</th>
                                                <th>Updated</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% transportOptions.forEach(t=> { %>
                                                <tr>
                                                    <td class="fw-semibold">
                                                        <%= t.departure_location %> &rarr; <%= t.destination_name %>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-secondary text-uppercase">
                                                            <%= t.transport_type %>
                                                        </span>
                                                        <span class="text-muted">
                                                            <%= t.comfort_tier %>
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <%= t.operator_name %>
                                                    </td>
                                                    <td class="fw-bold">৳<%= Number(t.one_way_fare_bdt).toLocaleString()
                                                            %>
                                                    </td>
                                                    <td>
                                                        <%= t.return_fare_bdt ? '৳' +
                                                            Number(t.return_fare_bdt).toLocaleString() : '2x One-Way' %>
                                                    </td>
                                                    <td>
                                                        <% if (t.is_verified) { %>
                                                            <span
                                                                class="badge bg-success-subtle text-success">Verified</span>
                                                            <% } else { %>
                                                                <span
                                                                    class="badge bg-warning-subtle text-warning-emphasis">Estimated</span>
                                                                <% } %>
                                                    </td>
                                                    <td>
                                                        <%= new Date(t.last_updated_at).toLocaleDateString() %>
                                                    </td>
                                                    <td>
                                                        <form action="/admin/transport/<%= t.id %>/delete" method="POST"
                                                            class="d-inline">
                                                            <input type="hidden" name="_csrf"
                                                                value="<%= csrfToken %>" />
                                                            <button
                                                                class="btn btn-outline-danger btn-sm py-0 px-2">Delete</button>
                                                        </form>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <%- include('../partials/footer') %>