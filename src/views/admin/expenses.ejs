<%- include('../partials/head') %>
    <%- include('../partials/navbar') %>
        <%- include('../partials/flash') %>

            <div class="container-fluid container-xl py-4">
                <div class="row g-4">
                    <div class="col-lg-3">
                        <%- include('../partials/adminSidebar') %>
                    </div>

                    <div class="col-lg-9">
                        <h3 class="fw-bold mb-3">Food, Local Transport, Activities & Tour Packages</h3>

                        <!-- 1. Food Costs Management -->
                        <div class="card border-0 shadow-sm rounded-4 mb-4">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="fw-bold text-bd-emerald mb-0">Daily Food Cost Per Person (BDT ৳)</h5>
                                    <a href="/admin/csv/export/food" class="btn btn-outline-success btn-sm">Export Food
                                        CSV</a>
                                </div>
                                <form action="/admin/expenses/food" method="POST" class="row g-2 mb-3 align-items-end">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                    <div class="col-md-3">
                                        <label class="form-label small fw-semibold">Destination</label>
                                        <select name="destination_id" class="form-select form-select-sm" required>
                                            <% destinations.forEach(d=> { %>
                                                <option value="<%= d.id %>">
                                                    <%= d.name %>
                                                </option>
                                                <% }) %>
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label small fw-semibold">Tier</label>
                                        <select name="tier" class="form-select form-select-sm">
                                            <option value="budget">Budget</option>
                                            <option value="standard" selected>Standard</option>
                                            <option value="premium">Premium</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label small fw-semibold">Breakfast (৳)</label>
                                        <input type="number" name="breakfast_cost_bdt"
                                            class="form-control form-control-sm" value="120" required />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label small fw-semibold">Lunch (৳)</label>
                                        <input type="number" name="lunch_cost_bdt" class="form-control form-control-sm"
                                            value="300" required />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label small fw-semibold">Dinner (৳)</label>
                                        <input type="number" name="dinner_cost_bdt" class="form-control form-control-sm"
                                            value="350" required />
                                    </div>
                                    <div class="col-md-1">
                                        <label class="form-label small fw-semibold">Snacks</label>
                                        <input type="number" name="snacks_water_cost_bdt"
                                            class="form-control form-control-sm" value="80" required />
                                    </div>
                                    <div class="col-12 d-flex justify-content-end mt-2">
                                        <button type="submit" class="btn btn-bd-emerald btn-sm">Save / Update Meal
                                            Tier</button>
                                    </div>
                                </form>

                                <div class="table-responsive">
                                    <table class="table table-sm table-hover align-middle small mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Destination</th>
                                                <th>Tier</th>
                                                <th>Breakfast</th>
                                                <th>Lunch</th>
                                                <th>Dinner</th>
                                                <th>Snacks/Water</th>
                                                <th>Total / Day / Person</th>
                                                <th>Updated</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% foodCosts.forEach(fc=> { %>
                                                <% const dailyTotal=Number(fc.breakfast_cost_bdt) +
                                                    Number(fc.lunch_cost_bdt) + Number(fc.dinner_cost_bdt) +
                                                    Number(fc.snacks_water_cost_bdt); %>
                                                    <tr>
                                                        <td>
                                                            <%= fc.destination_name %>
                                                        </td>
                                                        <td><span class="badge bg-secondary text-uppercase">
                                                                <%= fc.tier %>
                                                            </span></td>
                                                        <td>৳<%= fc.breakfast_cost_bdt %>
                                                        </td>
                                                        <td>৳<%= fc.lunch_cost_bdt %>
                                                        </td>
                                                        <td>৳<%= fc.dinner_cost_bdt %>
                                                        </td>
                                                        <td>৳<%= fc.snacks_water_cost_bdt %>
                                                        </td>
                                                        <td class="fw-bold text-bd-emerald">৳<%=
                                                                dailyTotal.toLocaleString() %>
                                                        </td>
                                                        <td>
                                                            <%= new Date(fc.last_updated_at).toLocaleDateString() %>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Additional Expenses (Local Transport, Chander Gari, Boat Trips, Guide Fees) -->
                        <div class="card border-0 shadow-sm rounded-4">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="fw-bold text-bd-emerald mb-0">Local Transport, Boat Trips & Miscellaneous
                                        Expenses</h5>
                                    <a href="/admin/csv/export/additional" class="btn btn-outline-success btn-sm">Export
                                        Expenses CSV</a>
                                </div>
                                <form action="/admin/expenses/additional" method="POST"
                                    class="row g-2 mb-3 align-items-end">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                                    <div class="col-md-3">
                                        <label class="form-label small fw-semibold">Destination</label>
                                        <select name="destination_id" class="form-select form-select-sm" required>
                                            <% destinations.forEach(d=> { %>
                                                <option value="<%= d.id %>">
                                                    <%= d.name %>
                                                </option>
                                                <% }) %>
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label small fw-semibold">Category</label>
                                        <select name="expense_category" class="form-select form-select-sm">
                                            <option value="local_transport">Local Transport</option>
                                            <option value="boat_trip">Boat / Trawler Trip</option>
                                            <option value="activity">Activity</option>
                                            <option value="guide_fee">Local Guide Fee</option>
                                            <option value="parking">Parking</option>
                                            <option value="misc">Miscellaneous</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small fw-semibold">Item Title</label>
                                        <input type="text" name="title" class="form-control form-control-sm"
                                            placeholder="e.g., Auto/CNG Local Sightseeing" required />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label small fw-semibold">Pricing Basis</label>
                                        <select name="pricing_basis" class="form-select form-select-sm">
                                            <option value="per_person_per_day">Per Person / Day</option>
                                            <option value="per_person_flat">Per Person (Flat)</option>
                                            <option value="per_group_per_day">Per Group / Day</option>
                                            <option value="per_group_flat">Per Group (Flat)</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label small fw-semibold">Cost (৳)</label>
                                        <input type="number" name="cost_bdt" class="form-control form-control-sm"
                                            value="250" required />
                                    </div>
                                    <div class="col-12 d-flex justify-content-end mt-2">
                                        <button type="submit" class="btn btn-bd-emerald btn-sm">Add Expense
                                            Item</button>
                                    </div>
                                </form>

                                <div class="table-responsive">
                                    <table class="table table-sm table-hover align-middle small mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Destination</th>
                                                <th>Category</th>
                                                <th>Title</th>
                                                <th>Basis</th>
                                                <th>Cost (৳)</th>
                                                <th>Updated</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% additionalExpenses.forEach(ae=> { %>
                                                <tr>
                                                    <td>
                                                        <%= ae.destination_name %>
                                                    </td>
                                                    <td><span class="badge bg-info-subtle text-info-emphasis">
                                                            <%= ae.expense_category %>
                                                        </span></td>
                                                    <td class="fw-semibold">
                                                        <%= ae.title %>
                                                    </td>
                                                    <td>
                                                        <%= ae.pricing_basis %>
                                                    </td>
                                                    <td class="fw-bold">৳<%= Number(ae.cost_bdt).toLocaleString() %>
                                                    </td>
                                                    <td>
                                                        <%= new Date(ae.last_updated_at).toLocaleDateString() %>
                                                    </td>
                                                    <td>
                                                        <form action="/admin/expenses/additional/<%= ae.id %>/delete"
                                                            method="POST" class="d-inline">
                                                            <input type="hidden" name="_csrf"
                                                                value="<%= csrfToken %>" />
                                                            <button
                                                                class="btn btn-link text-danger btn-sm p-0">Delete</button>
                                                        </form>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <%- include('../partials/footer') %>