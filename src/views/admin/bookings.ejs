<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<div class="container-fluid container-xl py-4">
  <div class="row g-4">
    <div class="col-lg-3">
      <%- include('../partials/adminSidebar') %>
    </div>

    <div class="col-lg-9">
      <h3 class="fw-bold mb-3">Booking Requests & Generated Travel Plans</h3>

      <!-- Bookings Table -->
      <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
          <h5 class="fw-bold mb-3">All Tour Agent Bookings</h5>
          <div class="table-responsive">
            <table class="table table-hover align-middle small mb-0">
              <thead class="table-light">
                <tr>
                  <th>Reference</th>
                  <th>Tourist</th>
                  <th>Destination</th>
                  <th>Agency</th>
                  <th>Travel Dates</th>
                  <th>Group</th>
                  <th>Agent Fee</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% bookings.forEach(b => { %>
                  <tr>
                    <td><code><%= b.booking_reference %></code></td>
                    <td><%= b.tourist_name %> (<%= b.tourist_phone %>)</td>
                    <td><%= b.destination_name %></td>
                    <td><%= b.agency_name %></td>
                    <td><%= new Date(b.departure_date).toLocaleDateString() %> - <%= new Date(b.return_date).toLocaleDateString() %></td>
                    <td><%= b.travelers_count %> pax</td>
                    <td>৳<%= Number(b.agreed_agent_fee_bdt).toLocaleString() %></td>
                    <td><span class="badge bg-secondary text-uppercase"><%= b.status %></span></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Saved Travel Plans -->
      <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
          <h5 class="fw-bold mb-3">Recent Tourist Travel Plans</h5>
          <div class="table-responsive">
            <table class="table table-hover align-middle small mb-0">
              <thead class="table-light">
                <tr>
                  <th>Plan Title</th>
                  <th>Tourist</th>
                  <th>Route</th>
                  <th>Travelers</th>
                  <th>Budget (৳)</th>
                  <th>Estimated Cost (৳)</th>
                  <th>Budget Fit</th>
                </tr>
              </thead>
              <tbody>
                <% travelPlans.forEach(tp => { %>
                  <tr>
                    <td class="fw-semibold"><%= tp.plan_title %></td>
                    <td><%= tp.user_name || 'Guest' %></td>
                    <td><%= tp.starting_location %> &rarr; <%= tp.destination_name %></td>
                    <td><%= tp.total_travelers %></td>
                    <td>৳<%= Number(tp.total_budget_bdt).toLocaleString() %></td>
                    <td class="fw-bold">৳<%= Number(tp.total_estimated_cost_bdt).toLocaleString() %></td>
                    <td>
                      <% if (tp.fits_budget) { %>
                        <span class="badge bg-success-subtle text-success">Fits Budget</span>
                      <% } else { %>
                        <span class="badge bg-danger-subtle text-danger">Deficit: ৳<%= Math.abs(Number(tp.budget_difference_bdt)).toLocaleString() %></span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>